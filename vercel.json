{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/cover-photo.jpg",
      "dest": "/cover-photo.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
